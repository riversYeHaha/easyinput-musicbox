# 目标芯片 esp32s3（SoC: ESP32-S3R8，板型 EasyInput V2.0 / PCB AI Keyboard V2.1）
CONFIG_IDF_TARGET="esp32s3"

# 板载 16MB Flash（dio / 80m）
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n

# 8MB Octal PSRAM：malloc 默认走内部 SRAM，显式 MALLOC_CAP_SPIRAM 才落 PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set

# 自定义分区表（factory 2MB + rec 1MB + songs ~12.9MB）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# 控制台走原生 USB（GPIO19/20 USB Serial/JTAG），日志/协议/烧录同口
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# FreeRTOS tick 1ms：按键去抖等 ms 级时序依赖它
CONFIG_FREERTOS_HZ=1000
